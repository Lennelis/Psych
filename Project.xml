<?xml version="1.0" encoding="utf-8"?>
<project>
	<!-- _________________________ Application Settings _________________________ -->

	<app title="Friday Night Funkin': Psych Engine" file="PsychEngine" packageName="com.shadowmario.psychengine" package="com.shadowmario.psychengine" main="Main" version="0.2.8" company="ShadowMario" />

	<!--Switch Export with Unique ApplicationID and Icon-->
	<set name="APP_ID" value="0x0100f6c013bbc000" />

	<!-- NOTE TO SELF: DISABLE THIS IF ISSUES ARE FOUND -->
	<haxedef name="LINC_LUA_RELATIVE_DYNAMIC_LIB"/> <!-- stable luas PUT AFTER FIRST LINE WITH APP NAME AND ETC -->

	<!--The flixel preloader is not accurate in Chrome. You can use it regularly if you embed the swf into a html file
		or you can set the actual size of your file manually at "FlxPreloaderBase-onUpdate-bytesTotal"-->
	<!-- <app preloader="Preloader" resizable="true" /> -->
	<app preloader="flixel.system.FlxPreloader" />

	<!--Minimum without FLX_NO_GAMEPAD: 11.8, without FLX_NO_NATIVE_CURSOR: 11.2-->
	<set name="SWF_VERSION" value="11.8" />
	
	<!-- ______________________ PSYCH ENGINE CUSTOMIZATION ______________________ -->

	<!--
		Mods read their content off the real filesystem, so most of Psych's asset
		lookups used to be written as an either/or: with MODS_ALLOWED on they checked
		FileSystem and never fell back to the packaged assets. That holds on desktop,
		where `assets` is a loose folder beside the executable, but on Android it lives
		inside the .apk - which is why switching this on once made the base game
		invisible. Those sites now go through Paths.pathExists and Paths.getFileContent,
		which look in both places, so it is safe on every target. See docs/MOBILE.md.
	-->
	<define name="MODS_ALLOWED" />
	<define name="HSCRIPT_ALLOWED" if="desktop || mobile" /> <!-- hscript-iris is pure Haxe, so it works on phones as-is -->
	<define name="LUA_ALLOWED" if="desktop || android" /> <!-- iOS forbids JIT, so LuaJIT is desktop + Android only -->
	<define name="ACHIEVEMENTS_ALLOWED" />
	<define name="DISCORD_ALLOWED" if="desktop" /> <!-- hxdiscord_rpc has no mobile build, and there's no Discord client to talk to anyway -->
	<define name="TOUCH_CONTROLS_ALLOWED" if="mobile" /> <!-- add this by hand to try the on-screen controls on a desktop build -->
	<define name="TRANSLATIONS_ALLOWED" />
	<define name="IRIS_DEBUG"/>
	
	<define name="MULTITHREADED_LOADING" /> <!-- UNCOMMENTING THIS LINE WILL ENABLE MULTITHREADED LOADING, WHICH IMPROVES LOADING TIMES, BUT APPARENTLY CAN FREEZE THE GAME ON SONG LOAD IN OLDER PCs? -->
	<define name="SHOW_LOADING_SCREEN" />
	<define name="PSYCH_WATERMARKS"/> <!-- DELETE THIS TO REMOVE THE PSYCH LOGO FROM LOADING SCREEN -->

	<section if="officialBuild">
		<define name="TITLE_SCREEN_EASTER_EGG"/>
		<define name="BASE_GAME_FILES" />
		<define name="VIDEOS_ALLOWED" if="windows || linux || android || mac" unless="32bits || NO_VIDEOS"/> <!-- IF YOU WANT TO USE VIDEOS ON YOUR SOURCE MOD, GET THIS LINE OUTSIDE OF THE SECTION -->
		<!-- hxvlc does build for Android, but it's the most fragile native dependency here.
		     Build with -DNO_VIDEOS to leave it out; only cutscenes are affected. -->
	</section>

	<!-- ____________________________ Window Settings ___________________________ -->

	<!--These window settings apply to all targets-->
	<window width="1280" height="720" fps="60" background="#000000" hardware="true" vsync="false" allow-high-dpi="true" />

	<!--HTML5-specific-->
	<window if="html5" resizable="true" />

	<!--Desktop-specific-->
	<window if="desktop" orientation="landscape" fullscreen="false" resizable="true" vsync="false"/>

	<!--Mobile-specific-->
	<window if="mobile" orientation="landscape" fullscreen="true" width="0" height="0" resizable="false"/>

	<!--Switch-specific-->
	<window if="switch" orientation="landscape" fullscreen="true" width="0" height="0" resizable="true" />

	<!-- _____________________________ Path Settings ____________________________ -->

	<set name="BUILD_DIR" value="export/debug" if="debug" />
	<set name="BUILD_DIR" value="export/release" unless="debug" />
	<set name="BUILD_DIR" value="export/32bit" if="32bits" />

	<classpath name="source" />

	<!-- __________________________ Game Assets & Etc. __________________________ -->
	
	<!-- Turn on Crash Handler -->
	<define name="CRASH_HANDLER" if="desktop release" />
	<define name="CRASH_HANDLER" if="mobile release" />

	<!-- Assets -->
	<assets path="assets/fonts" />
	<assets path="assets/shared"        exclude="*.ogg" if="web"/>
	<assets path="assets/shared"        exclude="*.mp3" unless="web"/>
	<assets path="assets/embed"         exclude="*.ogg" if="web" embed="true"/>
	<assets path="assets/embed"         exclude="*.mp3" unless="web" embed="true"/>
	<assets path="assets/videos"        if="VIDEOS_ALLOWED"/>
	<assets path="assets/songs"         exclude="*.ogg" if="web"/>
	<assets path="assets/songs"         exclude="*.mp3" unless="web"/>
	<assets path="assets/week_assets"   rename="assets" exclude="*.ogg" if="web"/>
	<assets path="assets/week_assets"   rename="assets" exclude="*.mp3" unless="web"/>
	<section if="TITLE_SCREEN_EASTER_EGG">
		<assets path="assets/secrets" rename="assets/shared" exclude="*.ogg" if="web"/>
		<assets path="assets/secrets" rename="assets/shared" exclude="*.mp3"  unless="web"/>
	</section>

	<section if="TRANSLATIONS_ALLOWED">
		<assets path="assets/translations" rename="assets" exclude="*.ogg" if="web"/>
		<assets path="assets/translations" rename="assets" exclude="*.mp3"  unless="web"/>
	</section>

	<section if="BASE_GAME_FILES">
		<assets path="assets/base_game" rename="assets" exclude="*.ogg" if="web"/>
		<assets path="assets/base_game" rename="assets" exclude="*.mp3"  unless="web"/>
		<haxelib name="grig.audio" if="BASE_GAME_FILES"/>
		<haxelib name="funkin.vis" if="BASE_GAME_FILES"/>
	</section>

	<define name="CHECK_FOR_UPDATES" if="desktop officialBuild"/>

	<section if="MODS_ALLOWED">
		<assets path='example_mods' rename='mods' embed='false' type='template' unless="mac || mobile"/>
		<assets path='example_mods' rename='mods' embed='false' if="mac"/>
		<!-- On mobile these are packed into the app and StorageUtil writes them out on first launch -->
		<assets path='example_mods' rename='mods' embed='false' if="mobile"/>
		<assets path='list.txt' rename='modsList.txt' />
	</section>
	<assets path='art/readme.txt' rename='do NOT readme.txt' />

	<!-- OpenAL config -->
	<section if="desktop">
		<assets path="alsoft.txt" rename="plugins/alsoft.ini" type="text" if="windows"/>
		<assets path="alsoft.txt" rename="plugins/alsoft.conf" type="text" unless="windows"/>
	</section>

	<!-- _______________________________ Libraries ______________________________ -->

	<haxelib name="flixel" version="5.6.1"/>
	<haxelib name="flixel-addons" version="3.2.2"/>
	<haxelib name="tjson" version="1.4.0"/>

	<!--Psych stuff needed-->
	<haxelib name="linc_luajit" if="LUA_ALLOWED"/>
	<haxelib name="hscript-iris" if="HSCRIPT_ALLOWED" version="1.1.3"/>
	<haxelib name="hxvlc" if="VIDEOS_ALLOWED" version="2.0.1"/>
	<haxelib name="hxdiscord_rpc" version="1.2.4" if="DISCORD_ALLOWED"/>
	<haxelib name="flxanimate"/>

	<!--Mobile stuff-->
	<haxelib name="extension-androidtools" if="android"/>

	<!-- Disable Discord IO Thread -->
	<haxedef name="DISCORD_DISABLE_IO_THREAD" if="hxdiscord_rpc" />
	<haxedef name="NO_PRECOMPILED_HEADERS" if="linux" />

	<!-- Enables a terminal log prompt on debug builds -->
	<haxelib name="hxcpp-debug-server" if="debug" unless="mobile"/>
	<haxedef name="HXC_LIBVLC_LOGGING" if="VIDEOS_ALLOWED debug" />
	<haxedef name="HXVLC_NO_SHARE_DIRECTORY" if="VIDEOS_ALLOWED" />
	<define name="x86_BUILD" if="32bits" />
	
	<!-- ___________________________ Mobile Targets _____________________________ -->

	<section if="android">
		<!--
			21 is the floor for the NDK toolchain lime uses. Target 33 rather than 34:
			lime sets compileSdkVersion from this, and lime 8.1.2 generates Gradle 7.4.2
			with Android Gradle Plugin 7.3.1, which refuses a compileSdk above 33. AGP 8
			would take 34 but drops the manifest `package` attribute lime's template
			still uses, so bumping it means patching the template too.

			The four permissions lime defaults to are spelled out below rather than left
			implicit, because the moment one <android permission="..."/> is declared lime
			stops applying its defaults - and losing VIBRATE would take the haptics with
			it.

			The storage three are what put mods somewhere a file manager can reach.
			MANAGE_EXTERNAL_STORAGE is the Android 11 and up one, granted through a
			settings page rather than a dialog; the older pair covers Android 10 and
			below. All of it is optional in practice: refused, the game falls back to its
			own folder and only mod installation gets harder. See
			mobile/backend/StorageUtil.hx.
		-->
		<android minimum-sdk-version="21" target-sdk-version="33" install-location="auto" />
		<android permission="android.permission.INTERNET" />
		<android permission="android.permission.ACCESS_NETWORK_STATE" />
		<android permission="android.permission.VIBRATE" />
		<android permission="android.permission.WAKE_LOCK" />
		<android permission="android.permission.READ_EXTERNAL_STORAGE" />
		<android permission="android.permission.WRITE_EXTERNAL_STORAGE" />
		<android permission="android.permission.MANAGE_EXTERNAL_STORAGE" />

		<!--
			Lime builds armeabi-v7a AND arm64-v8a by default, and each ABI is a separate
			full hxcpp compile of the whole engine - it roughly doubles an already slow
			build. arm64 is what Google Play requires and what every phone since about
			2016 runs, so drop 32-bit unless it's asked for:
			`lime build android -DARMV7`.
			Don't set HXCPP_ARM64 or HXCPP_ARMV7 here: lime sets them per ABI itself, and
			setting one globally would leak into the other ABI's compile.
		-->
		<architecture exclude="ARMV7" unless="ARMV7" />

		<!--
			Left unset, lime picks the newest build-tools installed in the SDK, which is
			usually right. Set ANDROID_BUILD_TOOLS to pin one - worth doing on a machine
			that has several, since AGP 7.3.1 is old enough to disagree with the newest.
		-->
		<section if="ANDROID_BUILD_TOOLS">
			<config type="android" build-tools-version="${ANDROID_BUILD_TOOLS}" />
		</section>

		<!--
			Android refuses to install an unsigned APK, so a release build needs a
			keystore. Set these three in the environment (or pass them with -D) and lime
			signs the build; leave them unset and nothing here applies. Nothing secret
			lives in this file. See docs/MOBILE.md.
		-->
		<section if="ANDROID_KEYSTORE">
			<certificate path="${ANDROID_KEYSTORE}" password="${ANDROID_KEYSTORE_PASSWORD}" alias="${ANDROID_KEYSTORE_ALIAS}" />
		</section>
	</section>

	<section if="ios">
		<!-- Lime and hxcpp pick the iOS architectures themselves, nothing to set here. -->
		<config type="ios" deployment="13.0" device="universal" />
	</section>

	<!-- ______________________________ Haxedefines _____________________________ -->

	<!--Enable the Flixel core recording system-->
	<!--<haxedef name="FLX_RECORD" />-->

	<!--Disable the right and middle mouse buttons-->
	<!-- <haxedef name="FLX_NO_MOUSE_ADVANCED" /> -->

	<!--Disable the native cursor API on Flash-->
	<!--<haxedef name="FLX_NO_NATIVE_CURSOR" />-->

	<!--Optimise inputs, be careful you will get null errors if you don't use conditionals in your game-->
	<!-- <haxedef name="FLX_NO_MOUSE" if="mobile" /> -->
	<!-- <haxedef name="FLX_NO_KEYBOARD" if="mobile" /> -->
	<!-- <haxedef name="FLX_NO_TOUCH" if="desktop" /> -->
	<!--<haxedef name="FLX_NO_GAMEPAD" />-->

	<!--Disable the Flixel core sound tray-->
	<!--<haxedef name="FLX_NO_SOUND_TRAY" />-->

	<!--Disable the Flixel sound management code-->
	<!--<haxedef name="FLX_NO_SOUND_SYSTEM" />-->

	<!--Disable the Flixel core focus lost screen-->
	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />
	
	<!-- Show debug traces for hxCodec -->
	<haxedef name="HXC_DEBUG_TRACE" if="debug" />
	
	<!--Disable the Flixel core debugger. Automatically gets set whenever you compile in release mode!-->
	<haxedef name="FLX_NO_DEBUG" unless="debug" />

	<!--Enable this for Nape release builds for a serious peformance improvement-->
	<haxedef name="NAPE_RELEASE_BUILD" unless="debug" />
	
	<!--Used for Izzy Engine's crash handler-->
	<haxedef name="HXCPP_CHECK_POINTER" if="CRASH_HANDLER" />
	<haxedef name="HXCPP_STACK_LINE" if="CRASH_HANDLER" />
	<haxedef name="HXCPP_STACK_TRACE" if="CRASH_HANDLER" />
	
	<!--Disable deprecated warnings-->
	<haxedef name='no-deprecation-warnings' />

	<!-- Haxe 4.3.0+: Enable pretty syntax errors and stuff. -->
	<!-- pretty (haxeflixel default), indent, classic (haxe compiler default) -->
	<haxedef name="message.reporting" value="pretty" />

	<!--Macro fixes-->
	<haxeflag name="--macro" value="allowPackage('flash')" />
	<haxeflag name="--macro" value="include('my.pack')" />

	<haxedef name="hscriptPos" if="HSCRIPT_ALLOWED" />

	<!-- _________________________________ Custom _______________________________ -->

	<assets path='art/icons/iconOG.png' rename='icon.png' if="linux || mac" />
	
	<icon path="art/icons/icon16.png" size='16'/>
	<icon path="art/icons/icon32.png" size='32'/>
	<icon path="art/icons/icon64.png" size='64'/>
	<icon path="art/icons/iconOG.png" />
</project>
